<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <meta name="theme-color" content="#0F172A">
    
    <!-- SEO Metadata -->
    <title>ZEROONE | Digital Experiences - استوديو الحلول الرقمية والمواقع الفاخرة</title>
    <meta name="description" content="استوديو ZEROONE للحلول الرقمية وتطوير دعوات الزفاف والمواقع والتجارب الرقمية الفاخرة. ابتكر حضورك الرقمي الفريد معنا.">
    <meta property="og:title" content="ZEROONE | Digital Experiences">
    <meta property="og:description" content="تطوير مواقع فاخرة، دعوات زفاف رقمية تفاعلية، وحلول برمجة وتسويق متكاملة.">
    <meta property="og:type" content="website">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&family=Reem+Kufi:wght@600;700;800&display=swap" rel="stylesheet">
    
    <!-- Icons & Animation -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>

    <style>
        :root {
            --bg-dark: #0B0F17;
            --card-dark: #151C28;
            --card-border: rgba(212, 175, 55, 0.2);
            --gold-primary: #D4AF37;
            --gold-hover: #F59E0B;
            --gold-gradient: linear-gradient(135deg, #BF953F 0%, #FCF6BA 25%, #B38728 50%, #FBF5B7 75%, #AA771C 100%);
            --text-main: #F8FAFC;
            --text-muted: #94A3B8;
            --radius-main: 24px;
            --radius-sm: 14px;
            --shadow-glow: 0 10px 40px rgba(212, 175, 55, 0.15);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-main);
            line-height: 1.6;
            overflow-x: hidden;
            background-image: 
                radial-gradient(rgba(212, 175, 55, 0.08) 1.5px, transparent 1.5px),
                radial-gradient(rgba(212, 175, 55, 0.05) 1.5px, var(--bg-dark) 1.5px);
            background-size: 36px 36px;
            background-position: 0 0, 18px 18px;
        }

        .font-kufi { font-family: 'Reem Kufi', sans-serif; }

        .gold-gradient-text {
            background: var(--gold-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: inline-block;
        }

        .container {
            width: 100%;
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Navbar Header */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            background: rgba(11, 15, 23, 0.85);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--card-border);
            padding: 16px 0;
        }

        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .brand-logo {
            text-decoration: none;
            display: flex;
            flex-direction: column;
        }

        .brand-logo .logo-title {
            font-family: 'Reem Kufi', sans-serif;
            font-size: 1.6rem;
            font-weight: 800;
            color: #FFF;
            line-height: 1;
            letter-spacing: 1px;
        }

        .brand-logo .logo-sub {
            font-size: 0.65rem;
            color: var(--gold-primary);
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .btn-contact-nav {
            background: var(--gold-gradient);
            color: var(--bg-dark);
            font-weight: 800;
            font-size: 0.85rem;
            padding: 8px 20px;
            border-radius: 50px;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .btn-contact-nav:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.4);
        }

        /* Hero Section */
        .hero-section {
            padding: 140px 0 60px;
            text-align: center;
            position: relative;
        }

        .badge-hero {
            background: rgba(212, 175, 55, 0.1);
            border: 1px solid var(--card-border);
            color: var(--gold-primary);
            font-size: 0.85rem;
            font-weight: 700;
            padding: 6px 20px;
            border-radius: 50px;
            display: inline-block;
            margin-bottom: 20px;
        }

        .hero-title {
            font-size: 2.8rem;
            font-weight: 900;
            line-height: 1.25;
            margin-bottom: 20px;
        }

        .hero-description {
            font-size: 1.15rem;
            color: var(--text-muted);
            max-width: 700px;
            margin: 0 auto 36px;
        }

        .cta-buttons {
            display: flex;
            justify-content: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        .btn-gold-lg {
            background: var(--gold-gradient);
            color: var(--bg-dark);
            font-weight: 800;
            font-size: 1.05rem;
            padding: 14px 36px;
            border-radius: 50px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            box-shadow: var(--shadow-glow);
            transition: all 0.3s ease;
        }

        .btn-gold-lg:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(212, 175, 55, 0.35);
        }

        .btn-outline-lg {
            background: transparent;
            color: #FFF;
            border: 2px solid var(--card-border);
            font-weight: 700;
            font-size: 1rem;
            padding: 12px 32px;
            border-radius: 50px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
        }

        .btn-outline-lg:hover {
            border-color: var(--gold-primary);
            color: var(--gold-primary);
        }

        /* Section Layouts */
        .section-padding {
            padding: 60px 0;
        }

        .section-header {
            text-align: center;
            margin-bottom: 48px;
        }

        .section-header h2 {
            font-size: 2.2rem;
            font-weight: 800;
            margin-bottom: 12px;
        }

        .section-header p {
            color: var(--text-muted);
            font-size: 1rem;
        }

        /* Services Grid */
        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 24px;
        }

        .service-card {
            background: var(--card-dark);
            border: 1px solid var(--card-border);
            border-radius: var(--radius-main);
            padding: 36px 28px;
            transition: all 0.35s ease;
            position: relative;
            overflow: hidden;
        }

        .service-card:hover {
            transform: translateY(-6px);
            border-color: var(--gold-primary);
            box-shadow: var(--shadow-glow);
        }

        .service-icon {
            width: 60px;
            height: 60px;
            border-radius: 18px;
            background: rgba(212, 175, 55, 0.1);
            border: 1px solid var(--gold-primary);
            color: var(--gold-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            margin-bottom: 24px;
        }

        .service-title {
            font-size: 1.35rem;
            font-weight: 800;
            margin-bottom: 12px;
        }

        .service-desc {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin-bottom: 20px;
        }

        .service-features {
            list-style: none;
            margin-bottom: 24px;
        }

        .service-features li {
            font-size: 0.88rem;
            color: #CBD5E1;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .service-features li i {
            color: var(--gold-primary);
            font-size: 0.8rem;
        }

        /* Portfolio Showcase Section */
        .portfolio-card {
            background: var(--card-dark);
            border: 1px solid var(--card-border);
            border-radius: var(--radius-main);
            overflow: hidden;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
            align-items: center;
        }

        @media (max-width: 768px) {
            .portfolio-card { grid-template-columns: 1fr; }
        }

        .portfolio-body {
            padding: 36px;
        }

        .portfolio-tag {
            color: var(--gold-primary);
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            display: block;
            margin-bottom: 8px;
        }

        .portfolio-title {
            font-size: 1.8rem;
            font-weight: 800;
            margin-bottom: 14px;
        }

        .portfolio-desc {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin-bottom: 24px;
        }

        .portfolio-preview-box {
            background: rgba(0, 0, 0, 0.4);
            border-radius: var(--radius-main);
            padding: 30px;
            text-align: center;
            margin: 20px;
            border: 1px solid var(--card-border);
        }

        /* Calculator / Solution Estimator */
        .calculator-card {
            background: var(--card-dark);
            border: 1px solid var(--card-border);
            border-radius: var(--radius-main);
            padding: 40px;
            max-width: 800px;
            margin: 0 auto;
        }

        .calc-option {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--card-border);
            border-radius: var(--radius-sm);
            padding: 16px 20px;
            margin-bottom: 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: all 0.2s ease;
        }

        .calc-option:hover, .calc-option.active {
            border-color: var(--gold-primary);
            background: rgba(212, 175, 55, 0.08);
        }

        /* Stats Bar */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            background: var(--card-dark);
            border: 1px solid var(--card-border);
            border-radius: var(--radius-main);
            padding: 30px;
            text-align: center;
            margin-top: 40px;
        }

        .stat-number {
            font-family: 'Reem Kufi', sans-serif;
            font-size: 2.2rem;
            font-weight: 800;
            color: var(--gold-primary);
        }

        .stat-label {
            font-size: 0.88rem;
            color: var(--text-muted);
        }

        /* Direct Contact Card */
        .contact-box {
            background: linear-gradient(180deg, var(--card-dark) 0%, #0F172A 100%);
            border: 2px solid var(--card-border);
            border-radius: var(--radius-main);
            padding: 48px 24px;
            text-align: center;
            position: relative;
            box-shadow: var(--shadow-glow);
        }

        /* Footer */
        .main-footer {
            border-top: 1px solid var(--card-border);
            padding: 30px 0;
            text-align: center;
            color: var(--text-muted);
            font-size: 0.88rem;
            margin-top: 60px;
        }

        .main-footer a {
            color: var(--gold-primary);
            text-decoration: none;
            font-weight: 700;
        }

        /* Mobile Adjustments */
        @media (max-width: 600px) {
            .hero-title { font-size: 2rem; }
            .hero-section { padding: 110px 0 40px; }
            .section-header h2 { font-size: 1.75rem; }
            .calculator-card { padding: 24px 16px; }
            .btn-gold-lg { width: 100%; justify-content: center; }
            .btn-outline-lg { width: 100%; justify-content: center; }
        }
    </style>
</head>
<body>

    <!-- Header Navigation -->
    <nav class="navbar">
        <div class="container nav-container">
            <a href="#" class="brand-logo">
                <span class="logo-title font-kufi">ZEROONE</span>
                <span class="logo-sub">Digital Experiences</span>
            </a>
            <a href="https://wa.me/249912934169" target="_blank" class="btn-contact-nav">
                <i class="fa-brands fa-whatsapp fs-6"></i> تواصل معنا
            </a>
        </div>
    </nav>

    <main>
        <!-- Hero Section -->
        <section class="hero-section">
            <div class="container animate__animated animate__fadeIn">
                <span class="badge-hero"><i class="fa-solid fa-sparkles me-2"></i>استوديو تجارب رقمية فاخرة</span>
                <h1 class="hero-title">نبتكر حضورك الرقمي <br><span class="gold-gradient-text">بأناقة وفخامة متكاملة</span></h1>
                <p class="hero-description">نصمم ونطور مواقع إلكترونية فاخرة، ودعوات زفاف وتطبيقات ويب عصرية تجمع بين جمال التصميم وسرعة الأداء لتترك انطباعاً دائماً لدى عملائك وضيوك.</p>
                <div class="cta-buttons">
                    <a href="https://wa.me/249912934169?text=مرحباً%20ZEROONE،%20أود%20طلب%20مشروع%20جديد" target="_blank" class="btn-gold-lg">
                        <i class="fa-brands fa-whatsapp fs-5"></i> ابدأ مشروعك الآن
                    </a>
                    <a href="#portfolio" class="btn-outline-lg">
                        <i class="fa-solid fa-eye me-2"></i> استعرض أعمالنا
                    </a>
                </div>
            </div>
        </section>

        <!-- Stats Bar -->
        <div class="container">
            <div class="stats-grid">
                <div>
                    <div class="stat-number">100%</div>
                    <div class="stat-label">تصاميم مخصصة وفريدة</div>
                </div>
                <div>
                    <div class="stat-number">Fast</div>
                    <div class="stat-label">سرعة فائقة وأداء عالي</div>
                </div>
                <div>
                    <div class="stat-number">Mobile First</div>
                    <div class="stat-label">متوافق كلياً مع الهواتف</div>
                </div>
            </div>
        </div>

        <!-- Services Section -->
        <section class="section-padding" id="services">
            <div class="container">
                <div class="section-header">
                    <h2>حلولنا والخدمات التي نقدمها</h2>
                    <p>نقدم مجموعة متكاملة من الخدمات الرقمية المصممة بعناية فائقة لتلبية تطلعاتك</p>
                </div>

                <div class="services-grid">
                    <!-- Service 1 -->
                    <div class="service-card">
                        <div class="service-icon">
                            <i class="fa-solid fa-gem"></i>
                        </div>
                        <h3 class="service-title font-kufi">دعوات الزفاف الرقمية</h3>
                        <p class="service-desc">مواقع وتصاميم زفاف تفاعلية فاخرة تعكس بهجة يومك الكبير مع كافة التفاصيل والميزات العصرية.</p>
                        <ul class="service-features">
                            <li><i class="fa-solid fa-check"></i> مشغل أغاني وسيرة مدمج</li>
                            <li><i class="fa-solid fa-check"></i> عدّاد تنازلي دقيق لليلة العمر</li>
                            <li><i class="fa-solid fa-check"></i> سجل تهاني حي ومباشر للضيوف</li>
                            <li><i class="fa-solid fa-check"></i> صفحة خاصة ومحمية بكلمة مرور</li>
                        </ul>
                        <a href="https://wa.me/249912934169?text=مرحباً،%20أريد%20طلب%20دعوة%20زفاف%20رقمية" target="_blank" class="btn-outline-lg w-100 text-center" style="font-size:0.88rem; padding:10px;">طلب الخدمة</a>
                    </div>

                    <!-- Service 2 -->
                    <div class="service-card">
                        <div class="service-icon">
                            <i class="fa-solid fa-laptop-code"></i>
                        </div>
                        <h3 class="service-title font-kufi">مواقع الأعمال والشركة</h3>
                        <p class="service-desc">تطوير مواقع تعريفية ومتاجر للأعمال والشركات الناشئة ترفع من قيمتك السوقية وتجذب العملاء.</p>
                        <ul class="service-features">
                            <li><i class="fa-solid fa-check"></i> واجهات مستخدم فاخرة (UI/UX)</li>
                            <li><i class="fa-solid fa-check"></i> سرعة تحميل وتوافق مع SEO</li>
                            <li><i class="fa-solid fa-check"></i> ربط مباشر بأزرار الواتساب</li>
                            <li><i class="fa-solid fa-check"></i> استضافة وسيرفرات سريعة</li>
                        </ul>
                        <a href="https://wa.me/249912934169?text=مرحباً،%20أريد%20استفسار%20عن%20تصميم%20موقع%20أعمال" target="_blank" class="btn-outline-lg w-100 text-center" style="font-size:0.88rem; padding:10px;">طلب الخدمة</a>
                    </div>

                    <!-- Service 3 -->
                    <div class="service-card">
                        <div class="service-icon">
                            <i class="fa-solid fa-headset"></i>
                        </div>
                        <h3 class="service-title font-kufi">المساعدة والدعم الرقمي</h3>
                        <p class="service-desc">تقديم حلول برمجية، إعداد الاستضافات، الاستشارات الفنية، والدعم المستمر لمشاريعك.</p>
                        <ul class="service-features">
                            <li><i class="fa-solid fa-check"></i> إعداد وربط النطاقات والدومينات</li>
                            <li><i class="fa-solid fa-check"></i> حل المشكلات البرمجية بسرعة</li>
                            <li><i class="fa-solid fa-check"></i> استشارات تحسين الأداء والمظهر</li>
                        </ul>
                        <a href="https://wa.me/249912934169?text=مرحباً،%20أحتاج%20مساعدة%20فنية%20أو%20استشارة" target="_blank" class="btn-outline-lg w-100 text-center" style="font-size:0.88rem; padding:10px;">طلب مساعدة</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Portfolio Showcase Section -->
        <section class="section-padding" id="portfolio">
            <div class="container">
                <div class="section-header">
                    <h2>نماذج من أعمالنا المتميزة</h2>
                    <p>استعرض أبرز المشاريع والتجارب الرقمية التي تم تنقيذها باحترافية عالية</p>
                </div>

                <!-- Showcase Item 1 -->
                <div class="portfolio-card">
                    <div class="portfolio-body">
                        <span class="portfolio-tag">Interactive Invitation Website</span>
                        <h3 class="portfolio-title font-kufi">دعوة زفاف فاخرة (ألفاهاشم & دينا)</h3>
                        <p class="portfolio-desc">موقع دعوة زفاف إلكتروني متكامل يحتوي على مشغل موسيقى عائم، عداد تنازلي حقيقي، سجل تبريكات حي مباشر، وصفحة محمية بكلمة سر للعرسان مع ربط الخريطة ومشاركة الواتساب.</p>
                        <a href="https://alfahashim.vercel.app/" target="_blank" class="btn-gold-lg" style="font-size:0.95rem; padding: 12px 28px;">
                            <i class="fa-solid fa-arrow-up-right-from-square me-2"></i> معاينة النموذج الحي
                        </a>
                    </div>
                    <div class="portfolio-preview-box">
                        <i class="fa-solid fa-crown gold-gradient-text display-3 mb-3"></i>
                        <h4 class="font-kufi">ألفاهاشم ❤️ دينا</h4>
                        <p class="text-muted small">دعوة زفاف رقمية فاخرة</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Quick Interactive Cost Estimator -->
        <section class="section-padding" id="estimator">
            <div class="container">
                <div class="section-header">
                    <h2>اختر الحل المناسب لمشروعك</h2>
                    <p>حدد احتياجك لمشروعك وسنساعدك في تنفيذه بأفضل الأفكار والمواصفات</p>
                </div>

                <div class="calculator-card">
                    <h3 class="font-kufi mb-4 text-center">ما هو نوع المشروع الذي ترغب في إنشائه؟</h3>
                    
                    <div class="calc-option active" onclick="selectOption(this, 'دعوة زفاف رقمية فاخرة')">
                        <div>
                            <strong>دعوة زفاف أو مناسبة رقمية</strong>
                            <div class="text-muted small">رابط خاص، أغنية سيرة، عدّاد، وتهاني مباشرة</div>
                        </div>
                        <i class="fa-solid fa-check-circle text-warning fs-5"></i>
                    </div>

                    <div class="calc-option" onclick="selectOption(this, 'موقع تعريف لأعمالك أو شركتك')">
                        <div>
                            <strong>موقع تعريفي لأعمالك / بورتفوليو</strong>
                            <div class="text-muted small">إبراز خدماتك، أعمالك، ووسائل التواصل بشكل احترافي</div>
                        </div>
                        <i class="fa-solid fa-circle text-muted fs-5"></i>
                    </div>

                    <div class="calc-option" onclick="selectOption(this, 'استشارة برمجية أو حلول تقنية')">
                        <div>
                            <strong>دعم تقني واستشارة خاصة</strong>
                            <div class="text-muted small">مساعدة في الاستضافة، الربط، أو تحسين موقع قائم</div>
                        </div>
                        <i class="fa-solid fa-circle text-muted fs-5"></i>
                    </div>

                    <div class="text-center mt-4">
                        <button onclick="submitEstimate()" class="btn-gold-lg w-100 justify-content-center">
                            <i class="fa-brands fa-whatsapp fs-5 me-2"></i> ارسل طلبك مباشرة للواتساب
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Direct Contact Section -->
        <section class="section-padding">
            <div class="container">
                <div class="contact-box">
                    <span class="badge-hero mb-3">هل لديك أفكار خاصة أو استفسار؟</span>
                    <h2 class="font-kufi gold-gradient-text display-4 mb-3">يسعدنا التواصل معك مباشرة</h2>
                    <p class="text-muted mb-4 max-w-lg mx-auto">فريق ZEROONE جاهز للرد على استفساراتك وتحويل أفكارك إلى واقع رقمي مبهر.</p>
                    
                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <a href="https://wa.me/249912934169?text=مرحباً%20زيرو%20ون،%20أريد%20التواصل%20معكم" target="_blank" class="btn-gold-lg">
                            <i class="fa-brands fa-whatsapp fs-4"></i> واتساب: 249912934169+
                        </a>
                        <a href="tel:+249912934169" class="btn-outline-lg">
                            <i class="fa-solid fa-phone me-2"></i> اتصال مباشر
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="main-footer">
        <div class="container">
            <div class="mb-2">
                <span class="font-kufi fw-bold fs-4 text-white">ZEROONE</span>
                <span class="d-block text-warning small font-monospace">DIGITAL EXPERIENCES</span>
            </div>
            <p class="mb-3 small">جميع الحقوق محفوظة © 2026 ZEROONE Digital Experiences</p>
            <p class="small">تصميم وتطوير التجارب والمواقع الرقمية الفاخرة</p>
        </div>
    </footer>

    <script>
        let selectedProjectType = 'دعوة زفاف رقمية فاخرة';

        function selectOption(element, projectType) {
            document.querySelectorAll('.calc-option').forEach(el => {
                el.classList.remove('active');
                const icon = el.querySelector('i');
                icon.className = 'fa-solid fa-circle text-muted fs-5';
            });

            element.classList.add('active');
            const currentIcon = element.querySelector('i');
            currentIcon.className = 'fa-solid fa-check-circle text-warning fs-5';
            selectedProjectType = projectType;
        }

        function submitEstimate() {
            const phone = "249912934169";
            const text = `مرحباً ZEROONE، أريد الاستفسار عن طلب: (${selectedProjectType}). أرجو تزويدي بالتفاصيل والعرض المناسب.`;
            const url = `https://wa.me/${phone}?text=${encodeURIComponent(text)}`;
            window.open(url, '_blank');
        }
    </script>
</body>
</html>
